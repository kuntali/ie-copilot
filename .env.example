OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini

# Agent runtime
IE_TEMPERATURE=0.1
IE_AGENT_TIMEOUT_SECONDS=60
IE_STRUCTURED_OUTPUT_RETRIES=1

# Optional Phoenix/OpenTelemetry tracing
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=ie-copilot
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
